# Integration tests (vendor/bin/phpunit --testsuite integration)
#
# Copy to .env.testing (git-ignored) and point it at a DEDICATED, EMPTY database whose name ends
# in "_test". The suite drops and recreates every table in that database on each run and refuses
# to start against any other database name.
#
# No payment, OAuth or mail credentials belong here: payments use an in-process fake gateway,
# mail uses the log driver, and encryption keys are generated afresh for every run.
APP_ENV=testing
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
FRONTEND_URL=http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=private_advisory_test
DB_USERNAME=pa_test
DB_PASSWORD=

MAIL_DRIVER=log
