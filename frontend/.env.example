# Build-time configuration for the public SPA. Everything prefixed VITE_ is compiled into
# public JavaScript: never put secrets here. Copy to .env.staging / .env.production (or set
# in CI) and build with `vite build --mode staging|production`.

# local | staging | production. Drives the environment ribbon shown outside production.
VITE_APP_ENV=local

# Absolute public origin, no trailing slash. Used for canonical and Open Graph URLs.
# Required for `npm run prerender`.
VITE_SITE_URL=http://localhost:5173

# API base. Leave unset to use same-origin /api/v1 (recommended: the web server proxies it).
# VITE_API_BASE=https://api.example.com/api/v1

# --- scripts/prerender.mjs (Node, not compiled into the bundle) ---
# PRERENDER_API_ORIGIN=http://127.0.0.1:8080
# CHROME_PATH=/usr/bin/chromium
# PRERENDER_EXTRA_ROUTES=/some-page,/another
# PRERENDER_TIMEOUT_MS=20000
