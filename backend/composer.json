{
    "name": "private-advisory/backend",
    "description": "Private executive advisory platform — REST API, admin services and background workers.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.9",
        "stripe/stripe-php": "^16.0",
        "phpmailer/phpmailer": "^6.9",
        "ezyang/htmlpurifier": "^4.18"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeds\\": "database/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8080 -t public public/index.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
