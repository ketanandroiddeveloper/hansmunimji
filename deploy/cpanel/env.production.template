# -----------------------------------------------------------------------------------------------
# PRODUCTION environment for https://www.hansterahiansh.com (cPanel).
#
# On the server, copy this to   ~/advisory/shared/.env.production   and   chmod 600   it.
# That directory is outside public_html; never place this file under public_html, never commit
# the filled-in copy, and never paste its values into chat, tickets or source code.
#
# Every blank value below is REQUIRED unless marked optional. Secrets are generated on the server
# or copied from the provider's dashboard directly into this file.
# -----------------------------------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
APP_NAME="Hansmuniji"
APP_URL=https://www.hansterahiansh.com
FRONTEND_URL=https://www.hansterahiansh.com
ADMIN_URL=https://www.hansterahiansh.com/admin
CORS_ALLOWED_ORIGINS=https://www.hansterahiansh.com
PUBLIC_MEDIA_URL=
PRACTICE_TIMEZONE=Asia/Kolkata
TRUSTED_PROXIES=
STORAGE_PATH=/home2/hanstebd/advisory/shared/storage   # must be the account's real home directory (echo $HOME)
FRONTEND_REBUILD_HOOK_URL=

# --- Database: create in cPanel → MySQL Databases (cPanel prefixes names with the account user) --
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=hanstebd_hansterahiansh
DB_USERNAME=                       # app user: SELECT, INSERT, UPDATE, DELETE only
DB_PASSWORD=                       # secret — generate in cPanel's password generator
DB_SSL_CA=
DB_MIGRATION_USERNAME=             # migration user: ALL PRIVILEGES on this database only
DB_MIGRATION_PASSWORD=             # secret

# --- Application keys (secret). Generate ON THE SERVER: php bin/console keys:generate --------------
# Back these up in a password manager: losing ENCRYPTION_KEYS makes encrypted client data unrecoverable.
APP_KEY=
BLIND_INDEX_KEY=
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY=1

# --- Sessions ----------------------------------------------------------------------------------
SESSION_SECURE_COOKIE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
ADMIN_REQUIRE_TWO_FACTOR=true

# --- Booking holds -----------------------------------------------------------------------------
SLOT_HOLD_MINUTES=10
PAYMENT_HOLD_MINUTES=30

# --- Payments ----------------------------------------------------------------------------------
# Phase 1 (site live while Razorpay reviews it): PAYMENTS_ENABLED=false and the three Razorpay values empty.
# Paid sessions and gatherings then show "online payment not available" and cannot be reserved.
# Phase 2: set PAYMENTS_ENABLED=true and fill in the live Razorpay values below.
PAYMENTS_ENABLED=false

# --- Razorpay LIVE (Dashboard in Live mode → Account & Settings → API keys / Webhooks) ----------
RAZORPAY_KEY_ID=                   # rzp_live_… (public identifier, sent to the checkout)
RAZORPAY_KEY_SECRET=               # secret — shown once when the live key is generated
RAZORPAY_WEBHOOK_SECRET=           # secret — the value you type when creating the LIVE webhook
RAZORPAY_CURRENCIES=INR            # add USD,AED,GBP only after International Payments is approved

# --- Stripe: disabled (no Stripe account for India). Leave all three empty. ---------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Calendar / Meet (production OAuth web client) ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=              # secret
GOOGLE_REDIRECT_URI=https://www.hansterahiansh.com/api/v1/admin/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_ACCOUNT_EMAIL=hansterahiansh@gmail.com   # the only Google account allowed to connect

# --- Email ---------------------------------------------------------------------------------------
# smtp  = a dedicated noreply@ mailbox on this cPanel server (SPF/DKIM already published); replies go to info@
# gmail = the Google account connected in the admin (From: that Gmail address; adds the gmail.send scope)
MAIL_DRIVER=smtp
MAIL_HOST=mail.hansterahiansh.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply@hansterahiansh.com
MAIL_PASSWORD=                     # secret — the noreply@ mailbox password (used only by the site)
MAIL_FROM_ADDRESS=noreply@hansterahiansh.com
MAIL_FROM_NAME="Hansmuniji"
MAIL_REPLY_TO=info@hansterahiansh.com       # client replies land in the monitored mailbox
MAIL_ADMIN_ADDRESS=info@hansterahiansh.com  # new requests and operational alerts
