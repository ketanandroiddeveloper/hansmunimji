# ---------------------------------------------------------------------------------------------
# Backend environment template. Copy to `.env` for local development only.
#
# Staging / production: inject these through your platform's secret manager, or keep
# `.env.staging` / `.env.production` OUTSIDE the web root and point ENV_PATH at that directory.
# When APP_ENV is injected, `.env.{APP_ENV}` is loaded and must declare the same APP_ENV.
# Never commit real values. Generate keys with:  php bin/console keys:generate
# ---------------------------------------------------------------------------------------------

APP_ENV=local                      # local | testing | staging | production
APP_DEBUG=true                     # must be false in production (enforced)
APP_NAME="Private Advisory"
APP_URL=http://127.0.0.1:8080      # this API's public origin (https required in production)
FRONTEND_URL=http://localhost:5173 # public site origin (https required in production)
ADMIN_URL=http://localhost:5173/admin
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_MEDIA_URL=                  # defaults to APP_URL/media; set to a CDN origin if used
PRACTICE_TIMEZONE=Asia/Kolkata
TRUSTED_PROXIES=                   # comma-separated proxy IPs whose X-Forwarded-For is trusted
FRONTEND_REBUILD_HOOK_URL=         # optional: POSTed after content edits to rebuild prerendered pages

# --- Database (application user needs SELECT/INSERT/UPDATE/DELETE only) ----------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=private_advisory
DB_USERNAME=private_advisory_app
DB_PASSWORD=
DB_SSL_CA=
# Optional separate user with DDL rights, used only by `bin/console migrate`
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

# --- Keys (secret) ---------------------------------------------------------------------------
APP_KEY=                           # base64:<32 bytes> — signs sessions, URLs, audit hashes
BLIND_INDEX_KEY=                   # base64:<32 bytes> — HMAC for searchable encrypted emails
ENCRYPTION_KEYS=                   # "1:<base64 32 bytes>[,2:<base64>]" — AES-256-GCM field keys
ENCRYPTION_ACTIVE_KEY=1            # version used for new writes; run keys:rotate after changing

# --- Sessions --------------------------------------------------------------------------------
SESSION_SECURE_COOKIE=false        # true everywhere except plain-http local development
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
ADMIN_REQUIRE_TWO_FACTOR=true      # admins must enrol in TOTP before using the admin; enforced outside local

# --- Booking holds ---------------------------------------------------------------------------
SLOT_HOLD_MINUTES=10
PAYMENT_HOLD_MINUTES=30

# --- Payments (test keys outside production; live keys only in production — enforced) -------
PAYMENTS_ENABLED=true              # false = this environment deliberately takes no payments (deploy:check then forbids keys)
RAZORPAY_KEY_ID=                   # rzp_test_… / rzp_live_…
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=                 # sk_test_… / sk_live_… (or a restricted rk_test_… / rk_live_…)
STRIPE_PUBLISHABLE_KEY=            # optional: pk_test_… / pk_live_…, only used to detect mixed modes
STRIPE_WEBHOOK_SECRET=             # whsec_…
# Currencies each merchant account is actually enabled for (subset of INR,USD,AED,GBP).
# Non-INR on Razorpay requires International Payments to be activated on the account.
RAZORPAY_CURRENCIES=INR
STRIPE_CURRENCIES=USD,AED,GBP

# --- Google Calendar / Meet (OAuth web client) -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/v1/admin/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_ACCOUNT_EMAIL=               # optional: refuse to connect any other Google account

# --- Email -----------------------------------------------------------------------------------
MAIL_DRIVER=log                    # log (local only) | smtp | gmail (sends via the Google account connected in the admin)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=concierge@example.com
MAIL_FROM_NAME="Private Office"
MAIL_REPLY_TO=                     # optional (smtp): where replies go when the From mailbox is unattended
MAIL_ADMIN_ADDRESS=                # receives operational alerts (no confidential content)
